# Configuración de Prometheus generada por Terraform (monitoring/main.tf).
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Balanceador: endpoint /metrics integrado en HAProxy (frontend "metricas").
  - job_name: haproxy
    static_configs:
      - targets: ["${lb}:8404"]

  # CPU, memoria y estado de cada contenedor.
  - job_name: cadvisor
    static_configs:
      - targets: ["${cadvisor}:8080"]
