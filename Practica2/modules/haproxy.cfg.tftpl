# Configuración de HAProxy generada por Terraform (loadbalancer.tf). No editar a mano.
global
    log stdout format raw local0

defaults
    mode http
    log global
    option httplog
    option forwardfor
    option redispatch
    retries 3
    timeout connect 5s
    timeout client  30s
    timeout server  30s

# Resolución DNS en caliente con el DNS interno de Docker: si una instancia
# se recrea y cambia de IP, HAProxy lo detecta sin reiniciarse.
resolvers docker
    nameserver dns 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry   1s
    hold valid      10s

frontend entrada
    bind *:8080
    default_backend aquarium_web

backend aquarium_web
    balance ${policy}
    default-server check inter 5s fall 3 rise 2 resolvers docker init-addr libc,none
%{ for name in backends ~}
    server ${name} ${name}:5000
%{ endfor ~}